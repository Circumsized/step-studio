{
  "name": "@step-studio/desktop-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:bridge": "esbuild src/preload.ts --bundle --format=iife --target=es2020 --outfile=dist/bridge-init.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:built": "node --test dist/test/*.test.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@step-studio/transport-desktop": "0.1.17",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.25.12"
  }
}
