{
  "name": "step-studio",
  "version": "0.1.17",
  "private": true,
  "description": "Desktop console for the step CLI (Step Code) \u2014 typed Studio Bridge, Tauri workbench, Windows installer and macOS app",
  "license": "MIT",
  "author": "Circumsized",
  "homepage": "https://github.com/Circumsized/step-studio",
  "bugs": {
    "url": "https://github.com/Circumsized/step-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Circumsized/step-studio.git"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "electron",
    "desktop",
    "coding-agent",
    "windows"
  ],
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/renderer",
    "apps/desktop-tauri",
    "apps/desktop-tui"
  ],
  "scripts": {
    "models:catalog:generate": "node scripts/model-catalog.mjs",
    "models:catalog:check": "node scripts/model-catalog.mjs --check",
    "build": "npm run build:packages && npm run build -w @step-studio/renderer",
    "typecheck": "node scripts/check.mjs --fast",
    "test": "npm run build && npm run test:built",
    "perf:streaming": "node scripts/streaming-perf-gate.mjs",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check.mjs --fast",
    "check:build": "node scripts/check.mjs --production",
    "check:selects": "node scripts/check-renderer-selects.mjs",
    "runtime:verify-source": "node scripts/verify-omp-source.mjs",
    "vendor:install-deps": "node scripts/install-omp-deps.mjs",
    "vendor:keys": "node scripts/runtime-signing-keys.mjs",
    "vendor:build:host": "node scripts/build-omp-host.mjs",
    "vendor:artifact": "npm run build && node scripts/runtime-artifact.mjs",
    "vendor:e2e:install": "node scripts/runtime-install-e2e.mjs",
    "vendor:build:natives": "node scripts/build-omp-natives.mjs",
    "vendor:verify:patches": "node scripts/verify-omp-patches.mjs",
    "vendor:overlay:apply": "node scripts/apply-omp-overlay.mjs",
    "vendor:patches:regen": "node scripts/regen-omp-patches.mjs",
    "updates:build": "node scripts/build-update-assets-v2.mjs",
    "updates:verify": "node scripts/verify-update-assets-v2.mjs",
    "test:built": "npm run test:built --workspaces --if-present",
    "build:packages": "node scripts/build-packages.mjs",
    "test:core": "node scripts/test-core.mjs",
    "test:tooling": "npm run build:packages && node --test scripts/*.test.mjs",
    "audit:deps": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "lint": "eslint apps/renderer/src packages/*/src scripts --ext .ts,.tsx,.mjs,.js,.cjs",
    "lint:fix": "eslint apps/renderer/src packages/*/src scripts --ext .ts,.tsx,.mjs,.js,.cjs --fix"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "app-builder-lib": "26.18.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  }
}
