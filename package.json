{
  "name": "step-studio",
  "version": "0.1.17",
  "private": true,
  "description": "Desktop console for the step CLI (Step Code) — typed Studio Bridge, Tauri workbench, Windows installer and macOS app",
  "license": "MIT",
  "author": "snowpear",
  "homepage": "https://github.com/the-snowpear/step-studio",
  "bugs": {
    "url": "https://github.com/the-snowpear/step-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-snowpear/step-studio.git"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "electron",
    "desktop",
    "coding-agent",
    "windows"
  ],
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/renderer",
    "apps/desktop-tauri",
    "apps/desktop-tui"
  ],
  "scripts": {
    "models:catalog:generate": "node scripts/model-catalog.mjs",
    "models:catalog:check": "node scripts/model-catalog.mjs --check",
    "build": "npm run build:packages && npm run build -w @step-studio/renderer",
    "typecheck": "node scripts/check.mjs --fast",
    "test": "npm run build && npm run test:built",
    "perf:streaming": "node scripts/streaming-perf-gate.mjs",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check.mjs --fast",
    "check:build": "node scripts/check.mjs --production",
    "check:selects": "node scripts/check-renderer-selects.mjs",
    "runtime:verify-source": "node scripts/verify-omp-source.mjs",
    "vendor:install-deps": "node scripts/install-omp-deps.mjs",
    "vendor:keys": "node scripts/runtime-signing-keys.mjs",
    "vendor:build:host": "node scripts/build-omp-host.mjs",
    "vendor:artifact": "npm run build && node scripts/runtime-artifact.mjs",
    "pack:win": "node scripts/pack-win.mjs",
    "pack:win:prepare": "node scripts/prepare-installer-resources.mjs",
    "pack:win:ui": "node scripts/build-installer-host.mjs",
    "pack:win:audit": "node scripts/audit-installer.mjs",
    "pack:mac": "node scripts/pack-mac.mjs",
    "pack:mac:prepare": "node scripts/prepare-installer-resources.mjs",
    "pack:mac:audit": "node scripts/audit-mac.mjs",
    "vendor:e2e:install": "node scripts/runtime-install-e2e.mjs",
    "vendor:build:natives": "node scripts/build-omp-natives.mjs",
    "vendor:verify:patches": "node scripts/verify-omp-patches.mjs",
    "vendor:overlay:apply": "node scripts/apply-omp-overlay.mjs",
    "vendor:patches:regen": "node scripts/regen-omp-patches.mjs",
    "updates:build": "node scripts/build-update-assets-v2.mjs",
    "updates:verify": "node scripts/verify-update-assets-v2.mjs",
    "test:built": "npm run test:built --workspaces --if-present",
    "build:packages": "npm run build -w @step-studio/studio-protocol && npm run build -w @step-studio/client-contract && npm run build -w @step-studio/platform && npm run build -w @step-studio/runtime-installer && npm run build -w @step-studio/transport-desktop && npm run build -w @step-studio/client && npm run build -w @step-studio/platform-win32 && npm run build -w @step-studio/studio-host && npm run build -w @step-studio/host-client-api && npm run build -w @step-studio/testkit",
    "test:core": "node scripts/test-core.mjs",
    "test:tooling": "npm run build:packages && node --test scripts/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^24.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
